---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}

  {% if page.pdf %}
    <div
      class="embed-responsive embed-responsive-16by9"
      style="position: relative; padding-bottom: 200%; height: 0; overflow: hidden; max-width: 100%;"
    >
      <object
        data="{{ page.pdf | prepend: 'assets/pdf/projects/' | relative_url }}"
        type="application/pdf"
        width="100%"
        height="600px"
      >
        <p>
          PDF plugin for this browser is not available.
          <a
            href="{{ page.pdf | prepend: 'assets/pdf/projects/' | relative_url }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            Click here to download the PDF file.
          </a>
        </p>
      </object>
    </div>
  {% endif %}
</div>
